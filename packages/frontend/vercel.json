{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "rewrites": [
    { "source": "/api/:path*", "destination": "http://localhost:3000/api/:path*" },
    { "source": "/agent", "destination": "http://localhost:3000/agent" },
    { "source": "/agent/:path*", "destination": "http://localhost:3000/agent/:path*" }
  ]
}
